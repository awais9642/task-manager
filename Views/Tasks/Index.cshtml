@model List<TaskManager.Models.TaskItem>

@{
    ViewData["Title"] = "Task Manager";
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Task Manager</h1>
            <p class="text-muted mb-0">
                Manage your daily tasks easily.
            </p>
        </div>

        <a asp-controller="Tasks"
           asp-action="Create"
           class="btn btn-primary">
            + Add Task
        </a>
    </div>

    <!-- Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Total Tasks</h6>
                    <h2 class="fw-bold">@Model.Count</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Completed</h6>
                    <h2 class="fw-bold text-success">
                        @Model.Count(t => t.IsCompleted)
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Pending</h6>
                    <h2 class="fw-bold text-warning">
                        @Model.Count(t => !t.IsCompleted)
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- Task List -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0">My Tasks</h5>
        </div>

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <h5>No tasks yet</h5>

                    <p class="text-muted">
                        Create your first task to get started.
                    </p>

                    <a asp-controller="Tasks"
                       asp-action="Create"
                       class="btn btn-primary">
                        Create Task
                    </a>

                </div>
            }
            else
            {
                foreach (var task in Model)
                {
                    <div class="task-item border rounded p-3 mb-3">

                        <div class="row align-items-center">

                            <!-- Task Information -->
                            <div class="col-md-8">

                                <div class="d-flex align-items-center gap-2">

                                    @if (task.IsCompleted)
                                    {
                                        <h5 class="mb-1 text-decoration-line-through text-muted">
                                            @task.Title
                                        </h5>

                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <h5 class="mb-1">
                                            @task.Title
                                        </h5>

                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }

                                </div>

                                <p class="text-muted mb-1">
                                    @task.Description
                                </p>

                                <small class="text-muted">
                                    Created:
                                    @task.CreatedAt.ToString("MMM dd, yyyy")
                                </small>

                            </div>

                            <!-- Actions -->
                            <div class="col-md-4 text-md-end mt-3 mt-md-0">

                                <form asp-controller="Tasks"
                                      asp-action="Complete"
                                      asp-route-id="@task.Id"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-success">

                                        @(task.IsCompleted
                                            ? "Undo"
                                            : "Complete")

                                    </button>

                                </form>

                                <form asp-controller="Tasks"
                                      asp-action="Delete"
                                      asp-route-id="@task.Id"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Are you sure you want to delete this task?');">
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>
                }
            }

        </div>

    </div>

</div>